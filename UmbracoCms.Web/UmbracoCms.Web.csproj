<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn),1573,1591,1712</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.5" />
    <PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" Version="1.3.1" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="SimpleMvcSitemap.Core" Version="4.4.0" />
    <PackageReference Include="Umbraco.Cms" Version="17.2.1" />
    <!-- TODO: Umbraco.Community.MediaColourFinder — no Umbraco 17 compatible version available yet (latest 1.0.2 targets Umbraco 10) -->
    <PackageReference Include="uSync" Version="17.0.4" />
  </ItemGroup>

  <!-- These config/schema files must not be copied into a referencing project's
       publish output — Sliki.Web owns its own copies and Azure App Settings
       supply all runtime values. -->
  <ItemGroup>
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings-schema*.json" CopyToPublishDirectory="Never" />
    <Content Update="umbraco-package-schema.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Components\_ViewImports.cshtml" Visible="false" />
    <Folder Include="Api/Models/" />
    <Folder Include="Models\PublishedModels\" />
    <Folder Include="umbraco/Data/" />
    <None Include="umbraco/Data/*.mdf" />
    <None Include="umbraco/Data/*.ldf" />
    <None Include="umbraco/Data/*.sdf" />
    <None Include="Modules/**/App_Plugins/**" />
  </ItemGroup>

  <PropertyGroup>
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <Import Project="Build.CustomTargets.targets" />
</Project>
