{
  "Application": {
    "Cache": {
      "Enabled": true
    }
  },
  "AccessToken": {
    "QueryParameterName": "access_token",
    "SharedToken": "change-this-token"
  },
  "BlobStorage": {
    "ConnectionString": "",
    "ServiceUri": "https://your-storage-account.blob.core.windows.net",
    "ContainerName": "sliki",
    "MaxUploadBytes": 10485760,
    "PageSize": 12,
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "image/bmp"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Global": {
        "Id": "dbd1e521-66df-4f36-9cc7-ba92b3de20a9",
        "SanitizeTinyMce": true,
        "UseHttps": true
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "RequestHandler": {
        "AddTrailingSlash": false
      },
      "RichTextEditor": {
        "CustomConfig": {
          "body_class": "s-rich-text",
          "entity_encoding": "raw"
        }
      },
      "Runtime": {
        "MaxRequestLength": 51200,
        "Mode": "Production"
      },
      "Security": {
        "UserPassword": {
          "RequiredLength": 10,
          "RequireNonLetterOrDigit": true,
          "RequireDigit": false,
          "RequireLowercase": true,
          "RequireUppercase": true
        }
      },
      "WebRouting": {
        "DisableFindContentByIdPath": true
      },
      "Logging": {
        "Directory": "~/App_Data/Logs"
      }
    }
  },
  "uSync": {
    "Settings": {
      "RootFolder": "umbraco/uSync/",
      "Folders": [ "umbraco/uSync/" ],
      "AddOnPing": false,
      "ExportOnSave": "None"
    },
    "Sets": {
      "default": {
        "HandlerDefaults": {
          "UseFlatStructure": false
        }
      }
    }
  }
}
