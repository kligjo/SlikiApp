@implements IAsyncDisposable
@inject ImageFileValidator ImageFileValidator
@inject ILogger<ImageUploader> Logger
@inject IJSRuntime JSRuntime

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-success" role="status">@StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(SelectionMessage))
{
    <div class="alert alert-warning" role="status">@SelectionMessage</div>
}

<section class="surface-card">
    <div class="section-header">
        <div>
            <h2>Choose images</h2>
            <p class="section-copy">
                Images: JPEG, PNG, GIF, WebP, BMP. Videos: MP4, MOV, WebM, AVI. Maximum file size:
                <strong>@FileSizeFormatter.Format(ImageFileValidator.MaxUploadBytes)</strong>.
            </p>
        </div>
    </div>

    <label class="form-label fw-semibold" for="image-upload-input">Browse for images</label>
    <InputFile id="image-upload-input"
               class="form-control"
               multiple
               accept="@ImageFileValidator.AcceptAttributeValue"
               OnChange="HandleFilesSelectedAsync" />

    <div class="upload-actions">
        <button type="button" class="btn btn-primary" @onclick="UploadAllAsync" disabled="@(!CanUploadAny)">
            Upload all
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="RetryFailedAsync" disabled="@(!HasFailedItems)">
            Retry failed
        </button>
        <button type="button" class="btn btn-link" @onclick="ClearSelectionAsync" disabled="@(!SelectedItems.Any() || IsUploading)">
            Clear selection
        </button>
    </div>
</section>

@if (!SelectedItems.Any())
{
    <section class="surface-card empty-state" aria-live="polite">
        <h2>No files selected yet</h2>
        <p>Use the file picker above to add one or more images for upload.</p>
    </section>
}
else
{
    <section class="upload-list" aria-live="polite">
        @foreach (var item in SelectedItems)
        {
            <article class="surface-card upload-item" @key="item.Id">
                <div class="preview-frame">
                    @if (!string.IsNullOrWhiteSpace(item.PreviewUrl))
                    {
                        <img src="@item.PreviewUrl" alt="" class="preview-image" />
                    }
                    else
                    {
                        <div class="preview-placeholder" aria-hidden="true">IMG</div>
                    }
                </div>

                <div class="upload-item-main">
                    <div class="upload-item-header">
                        <div>
                            <h3>@item.DisplayName</h3>
                            <p class="subtle-copy">@FileSizeFormatter.Format(item.SizeInBytes) • @item.BrowserContentType</p>
                        </div>
                        <span class="@GetStatusBadgeClass(item.State)">@GetStatusLabel(item.State)</span>
                    </div>

                    <div class="progress" role="progressbar" aria-label="Upload progress"
                         aria-valuenow="@item.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="@($"width:{item.ProgressPercent}%")">@item.ProgressPercent%</div>
                    </div>

                    <p class="status-copy">@item.StatusDetails</p>

                    @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                    {
                        <p class="text-danger mb-0">@item.ErrorMessage</p>
                    }
                </div>

                <div class="upload-item-actions">
                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="() => UploadItemAsync(item)"
                            disabled="@(!CanUploadItem(item))">
                        @(item.State == UploadState.Failed ? "Retry" : "Upload")
                    </button>
                </div>
            </article>
        }
    </section>
}

@code {
    private const string FileInputId = "image-upload-input";
    private const int MaxSelectedFiles = 100;

    private readonly List<SelectedUploadItem> SelectedItems = [];
    private DotNetObjectReference<ImageUploader>? _dotNetRef;
    private SelectedUploadItem? _activeItem;
    private TaskCompletionSource<(bool Success, string Response, string Error)>? _uploadTcs;

    private bool IsUploading { get; set; }
    private string? StatusMessage { get; set; }
    private string? SelectionMessage { get; set; }

    private bool CanUploadAny =>
        !IsUploading && SelectedItems.Any(item => item.State is UploadState.Pending or UploadState.Failed);

    private bool HasFailedItems =>
        !IsUploading && SelectedItems.Any(item => item.State == UploadState.Failed);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _dotNetRef = DotNetObjectReference.Create(this);
    }

    [JSInvokable]
    public void OnUploadProgress(int percent)
    {
        if (_activeItem is null) return;
        _activeItem.ProgressPercent = percent;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnUploadDone(bool success, string responseText, string error)
    {
        _uploadTcs?.TrySetResult((success, responseText, error));
    }

    private async Task HandleFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        try
        {
            StatusMessage = null;
            SelectionMessage = null;

            if (args.FileCount == 0) return;

            if (args.FileCount > MaxSelectedFiles)
            {
                SelectionMessage = $"Select up to {MaxSelectedFiles} images at a time.";
                return;
            }

            JsFileInfo[] jsFiles;
            try
            {
                jsFiles = await JSRuntime.InvokeAsync<JsFileInfo[]>("slikiGallery.registerFiles", FileInputId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to register files in JS.");
                SelectionMessage = "Could not read the selected files.";
                return;
            }

            foreach (var f in jsFiles)
            {
                var item = new SelectedUploadItem
                {
                    JsFileId = f.Id,
                    PreviewUrl = f.PreviewUrl,
                    DisplayName = FileNameSanitizer.SanitizeDisplayName(f.Name),
                    BrowserContentType = string.IsNullOrWhiteSpace(f.Type) ? "unknown" : f.Type,
                    SizeInBytes = f.Size
                };

                if (f.Size > ImageFileValidator.MaxUploadBytes)
                {
                    item.State = UploadState.Failed;
                    item.StatusDetails = "File rejected before upload.";
                    item.ErrorMessage = $"Exceeds the {FileSizeFormatter.Format(ImageFileValidator.MaxUploadBytes)} limit.";
                }

                SelectedItems.Add(item);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed while processing selected files.");
            SelectionMessage = $"The selected files could not be processed: {ex.Message}";
        }
    }

    private async Task UploadAllAsync()
    {
        if (IsUploading) return;
        IsUploading = true;
        StatusMessage = null;
        var uploadedCount = 0;

        foreach (var item in SelectedItems.Where(i => i.State is UploadState.Pending or UploadState.Failed).ToList())
        {
            if (await UploadCoreAsync(item)) uploadedCount++;
        }

        IsUploading = false;
        if (uploadedCount > 0)
            StatusMessage = uploadedCount == 1 ? "1 image uploaded successfully." : $"{uploadedCount} images uploaded successfully.";
    }

    private async Task RetryFailedAsync()
    {
        if (IsUploading) return;
        IsUploading = true;
        StatusMessage = null;
        foreach (var item in SelectedItems.Where(i => i.State == UploadState.Failed).ToList())
            await UploadCoreAsync(item);
        IsUploading = false;
    }

    private async Task UploadItemAsync(SelectedUploadItem item)
    {
        if (!CanUploadItem(item)) return;
        IsUploading = true;
        StatusMessage = null;
        await UploadCoreAsync(item);
        IsUploading = false;
    }

    private async Task<bool> UploadCoreAsync(SelectedUploadItem item)
    {
        item.State = UploadState.Uploading;
        item.ErrorMessage = null;
        item.StatusDetails = "Uploading...";
        item.ProgressPercent = 0;
        StateHasChanged();

        try
        {
            _activeItem = item;
            _uploadTcs = new TaskCompletionSource<(bool, string, string)>();

            await JSRuntime.InvokeVoidAsync("slikiGallery.uploadFile", item.JsFileId, _dotNetRef);

            var (success, responseText, error) = await _uploadTcs.Task;

            if (!success)
                throw new InvalidOperationException(error);

            item.State = UploadState.Success;
            item.ProgressPercent = 100;
            item.StatusDetails = "Uploaded successfully.";
            return true;
        }
        catch (Exception ex)
        {
            item.State = UploadState.Failed;
            item.ProgressPercent = 0;
            item.StatusDetails = "Upload failed.";
            item.ErrorMessage = ex.Message;
            return false;
        }
        finally
        {
            _activeItem = null;
            _uploadTcs = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ClearSelectionAsync()
    {
        if (IsUploading) return;
        var fileIds = SelectedItems.Select(i => i.JsFileId).ToArray();
        var previewUrls = SelectedItems.Select(i => i.PreviewUrl).Where(u => u is not null).ToArray();
        SelectedItems.Clear();
        StatusMessage = null;
        SelectionMessage = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("slikiGallery.releaseFiles", (object)fileIds);
            await JSRuntime.InvokeVoidAsync("slikiGallery.revokePreviewUrls", (object)previewUrls);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            var fileIds = SelectedItems.Select(i => i.JsFileId).ToArray();
            var previewUrls = SelectedItems.Select(i => i.PreviewUrl).Where(u => u is not null).ToArray();
            await JSRuntime.InvokeVoidAsync("slikiGallery.releaseFiles", (object)fileIds);
            await JSRuntime.InvokeVoidAsync("slikiGallery.revokePreviewUrls", (object)previewUrls);
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private bool CanUploadItem(SelectedUploadItem item) =>
        !IsUploading && item.State is UploadState.Pending or UploadState.Failed;

    private static string GetStatusBadgeClass(UploadState state) => state switch
    {
        UploadState.Success  => "badge text-bg-success",
        UploadState.Uploading => "badge text-bg-primary",
        UploadState.Failed   => "badge text-bg-danger",
        _                    => "badge text-bg-secondary"
    };

    private static string GetStatusLabel(UploadState state) => state switch
    {
        UploadState.Success  => "Uploaded",
        UploadState.Uploading => "Uploading",
        UploadState.Failed   => "Failed",
        _                    => "Ready"
    };

    private sealed record JsFileInfo(string Id, string? PreviewUrl, string Name, long Size, string Type);

    private enum UploadState { Pending, Uploading, Success, Failed }

    private sealed class SelectedUploadItem
    {
        public Guid Id { get; } = Guid.NewGuid();
        public required string JsFileId { get; init; }
        public string? PreviewUrl { get; init; }
        public required string DisplayName { get; init; }
        public required string BrowserContentType { get; init; }
        public required long SizeInBytes { get; init; }
        public UploadState State { get; set; }
        public int ProgressPercent { get; set; }
        public string StatusDetails { get; set; } = "Ready to upload.";
        public string? ErrorMessage { get; set; }
    }
}
