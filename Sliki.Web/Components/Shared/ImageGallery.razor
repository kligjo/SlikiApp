@inject IImageStorageService ImageStorageService
@inject ImageFileValidator ImageFileValidator

<section class="surface-card">
    <div class="gallery-toolbar">
        <div class="gallery-toolbar-item">
            <label class="form-label" for="image-filter">Filter by file name</label>
            <input id="image-filter" class="form-control" @bind="SearchText" @bind:event="oninput" placeholder="Search images" />
        </div>

        <div class="gallery-toolbar-item">
            <label class="form-label" for="sort-order">Sort</label>
            <select id="sort-order" class="form-select" @bind="SortBy">
                <option value="@ImageSortBy.LatestFirst">Newest first</option>
                <option value="@ImageSortBy.OldestFirst">Oldest first</option>
                <option value="@ImageSortBy.NameAscending">Name A-Z</option>
                <option value="@ImageSortBy.NameDescending">Name Z-A</option>
            </select>
        </div>

        <div class="gallery-toolbar-actions">
            <button type="button" class="btn btn-primary" @onclick="ApplyFiltersAsync">Apply</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ResetFiltersAsync">Reset</button>
        </div>
    </div>
</section>

@if (IsLoading)
{
    <section class="surface-card mt-3">
        <p class="mb-0">Loading images from Azure Blob Storage...</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <section class="surface-card mt-3">
        <p class="text-danger mb-0">@ErrorMessage</p>
    </section>
}
else if (CurrentPage is null || CurrentPage.TotalCount == 0)
{
    <section class="surface-card empty-state mt-3">
        <h2>No images found</h2>
        <p>Upload images first, or adjust the current filter.</p>
    </section>
}
else
{
    <section class="gallery-grid" aria-live="polite">
        @foreach (var image in CurrentPage.Items)
        {
            <button type="button" class="image-card" @onclick="() => OpenImage(image)" aria-haspopup="dialog">
                <img src="@GetImageUrl(image.BlobName)"
                     alt="@image.FileName"
                     class="gallery-thumbnail"
                     loading="lazy" />
                <span class="image-card-body">
                    <strong>@image.FileName</strong>
                    <span>@image.UploadedAt.LocalDateTime:g</span>
                    <span>@FileSizeFormatter.Format(image.SizeInBytes)</span>
                </span>
            </button>
        }
    </section>

    <nav class="pagination-shell" aria-label="Gallery pages">
        <button type="button" class="btn btn-outline-secondary" @onclick="() => ChangePageAsync(CurrentPage.PageNumber - 1)" disabled="@(CurrentPage.PageNumber <= 1)">
            Previous
        </button>
        <span>Page @CurrentPage.PageNumber of @CurrentPage.TotalPages</span>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => ChangePageAsync(CurrentPage.PageNumber + 1)" disabled="@(CurrentPage.PageNumber >= CurrentPage.TotalPages)">
            Next
        </button>
    </nav>
}

@if (SelectedImage is not null)
{
    <div class="lightbox-backdrop" role="dialog" aria-modal="true" aria-label="Image preview">
        <div class="lightbox-panel">
            <div class="lightbox-header">
                <div>
                    <h2>@SelectedImage.FileName</h2>
                    <p class="mb-0">@SelectedImage.UploadedAt.LocalDateTime:g • @FileSizeFormatter.Format(SelectedImage.SizeInBytes)</p>
                </div>
                <button type="button" class="btn btn-outline-light" @onclick="CloseImage">Close</button>
            </div>

            <img src="@GetImageUrl(SelectedImage.BlobName)"
                 alt="@SelectedImage.FileName"
                 class="lightbox-image" />
        </div>
    </div>
}

@code {
    private ImagePageResult? CurrentPage { get; set; }

    private GalleryImageItem? SelectedImage { get; set; }

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private string SearchText { get; set; } = string.Empty;

    private ImageSortBy SortBy { get; set; } = ImageSortBy.LatestFirst;

    private int PageSize => ImageFileValidator.PageSize;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync(1);
    }

    private async Task ApplyFiltersAsync() => await LoadPageAsync(1);

    private async Task ResetFiltersAsync()
    {
        SearchText = string.Empty;
        SortBy = ImageSortBy.LatestFirst;
        await LoadPageAsync(1);
    }

    private async Task ChangePageAsync(int pageNumber)
    {
        if (CurrentPage is null)
        {
            return;
        }

        await LoadPageAsync(Math.Clamp(pageNumber, 1, CurrentPage.TotalPages));
    }

    private async Task LoadPageAsync(int pageNumber)
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            CurrentPage = await ImageStorageService.GetImagesAsync(
                new ImageQuery(SearchText.Trim(), SortBy, pageNumber, PageSize),
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static string GetImageUrl(string blobName) => $"/images/{Uri.EscapeDataString(blobName)}";

    private void OpenImage(GalleryImageItem image) => SelectedImage = image;

    private void CloseImage() => SelectedImage = null;
}
