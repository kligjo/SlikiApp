@inject IImageStorageService ImageStorageService
@inject ImageFileValidator ImageFileValidator
@inject IJSRuntime JS

<div class="gallery-bar">
    <div class="gallery-bar-filters">
        <input class="form-control form-control-sm" @bind="SearchText" @bind:event="oninput"
               placeholder="Search images" aria-label="Filter by file name" />
        <select class="form-select form-select-sm" @bind="SortBy" aria-label="Sort order">
            <option value="@ImageSortBy.LatestFirst">Newest first</option>
            <option value="@ImageSortBy.OldestFirst">Oldest first</option>
            <option value="@ImageSortBy.NameAscending">Name A–Z</option>
            <option value="@ImageSortBy.NameDescending">Name Z–A</option>
        </select>
        <button type="button" class="btn btn-sm btn-primary" @onclick="ApplyFiltersAsync">Apply</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetFiltersAsync">Reset</button>
    </div>
    @if (CurrentPage is not null && CurrentPage.TotalCount > 0)
    {
        <button type="button" class="btn btn-sm @(SelectMode ? "btn-primary" : "btn-outline-secondary")"
                @onclick="ToggleSelectMode">
            @(SelectMode ? $"Cancel ({SelectedBlobNames.Count})" : "Select")
        </button>
    }
</div>

@if (IsLoading)
{
    <p class="gallery-status">Loading…</p>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="gallery-status text-danger">@ErrorMessage</p>
}
else if (CurrentPage is null || CurrentPage.TotalCount == 0)
{
    <p class="gallery-status">No images found. Upload some first.</p>
}
else
{
    <div class="photo-grid" aria-live="polite">
        @foreach (var image in CurrentPage.Items)
        {
            var isSelected = SelectedBlobNames.Contains(image.BlobName);
            <button type="button"
                    class="photo-tile @(isSelected ? "photo-tile--selected" : "")"
                    @onclick="() => OnTileClick(image)"
                    aria-label="@image.FileName">
                <img src="@GetImageUrl(image.BlobName)" alt="@image.FileName" loading="lazy" class="photo-thumb" />
                @if (SelectMode)
                {
                    <span class="photo-check" aria-hidden="true">@(isSelected ? "✓" : "")</span>
                }
            </button>
        }
    </div>

    <nav class="pagination-shell" aria-label="Gallery pages">
        <button type="button" class="btn btn-outline-secondary btn-sm"
                @onclick="() => ChangePageAsync(CurrentPage.PageNumber - 1)"
                disabled="@(CurrentPage.PageNumber <= 1)">‹ Prev</button>
        <span class="pagination-label">@CurrentPage.PageNumber / @CurrentPage.TotalPages</span>
        <button type="button" class="btn btn-outline-secondary btn-sm"
                @onclick="() => ChangePageAsync(CurrentPage.PageNumber + 1)"
                disabled="@(CurrentPage.PageNumber >= CurrentPage.TotalPages)">Next ›</button>
    </nav>
}

@if (SelectMode && SelectedBlobNames.Count > 0)
{
    <div class="select-bar">
        <span>@SelectedBlobNames.Count selected</span>
        <button type="button" class="btn btn-primary btn-sm" @onclick="DownloadSelectedAsync">
            Download @SelectedBlobNames.Count
        </button>
    </div>
}

@if (LightboxImage is not null)
{
    <div class="lightbox" role="dialog" aria-modal="true" aria-label="Image preview" @onclick="CloseLightbox">
        <div class="lightbox-inner" @onclick:stopPropagation>
            <div class="lightbox-top">
                <span class="lightbox-name">@LightboxImage.FileName</span>
                <div class="lightbox-top-actions">
                    <a class="btn btn-sm btn-outline-light"
                       href="@GetImageUrl(LightboxImage.BlobName)"
                       download="@LightboxImage.FileName"
                       @onclick:stopPropagation>↓ Download</a>
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="CloseLightbox">✕</button>
                </div>
            </div>

            <img src="@GetImageUrl(LightboxImage.BlobName)"
                 alt="@LightboxImage.FileName"
                 class="lightbox-img" />

            <div class="lightbox-nav">
                <button type="button" class="lightbox-nav-btn" @onclick="PrevImage"
                        disabled="@(LightboxIndex <= 0)">❮</button>
                <span class="lightbox-counter">@(LightboxIndex + 1) / @CurrentPage!.Items.Count</span>
                <button type="button" class="lightbox-nav-btn" @onclick="NextImage"
                        disabled="@(LightboxIndex >= (CurrentPage!.Items.Count - 1))">❯</button>
            </div>
        </div>
    </div>
}

@code {
    private ImagePageResult? CurrentPage { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private string SearchText { get; set; } = string.Empty;
    private ImageSortBy SortBy { get; set; } = ImageSortBy.LatestFirst;
    private int PageSize => ImageFileValidator.PageSize;

    private bool SelectMode { get; set; }
    private HashSet<string> SelectedBlobNames { get; } = [];

    private GalleryImageItem? LightboxImage { get; set; }
    private int LightboxIndex { get; set; }

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    private async Task ApplyFiltersAsync() => await LoadPageAsync(1);

    private async Task ResetFiltersAsync()
    {
        SearchText = string.Empty;
        SortBy = ImageSortBy.LatestFirst;
        await LoadPageAsync(1);
    }

    private async Task ChangePageAsync(int pageNumber)
    {
        if (CurrentPage is null) return;
        await LoadPageAsync(Math.Clamp(pageNumber, 1, CurrentPage.TotalPages));
    }

    private async Task LoadPageAsync(int pageNumber)
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            CurrentPage = await ImageStorageService.GetImagesAsync(
                new ImageQuery(SearchText.Trim(), SortBy, pageNumber, PageSize),
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnTileClick(GalleryImageItem image)
    {
        if (SelectMode)
        {
            if (!SelectedBlobNames.Remove(image.BlobName))
                SelectedBlobNames.Add(image.BlobName);
        }
        else
        {
            OpenLightbox(image);
        }
    }

    private void ToggleSelectMode()
    {
        SelectMode = !SelectMode;
        if (!SelectMode) SelectedBlobNames.Clear();
    }

    private void OpenLightbox(GalleryImageItem image)
    {
        LightboxIndex = CurrentPage!.Items.ToList().IndexOf(image);
        LightboxImage = image;
    }

    private void CloseLightbox() => LightboxImage = null;

    private void PrevImage()
    {
        if (CurrentPage is null || LightboxIndex <= 0) return;
        LightboxIndex--;
        LightboxImage = CurrentPage.Items.ElementAt(LightboxIndex);
    }

    private void NextImage()
    {
        if (CurrentPage is null || LightboxIndex >= CurrentPage.Items.Count - 1) return;
        LightboxIndex++;
        LightboxImage = CurrentPage.Items.ElementAt(LightboxIndex);
    }

    private async Task DownloadSelectedAsync()
    {
        if (CurrentPage is null) return;
        var toDownload = CurrentPage.Items
            .Where(i => SelectedBlobNames.Contains(i.BlobName))
            .Select(i => new { url = GetImageUrl(i.BlobName), name = i.FileName })
            .ToList();

        foreach (var item in toDownload)
        {
            await JS.InvokeVoidAsync("slikiGallery.downloadFile", item.url, item.name);
            await Task.Delay(300);
        }
    }

    private string GetImageUrl(string blobName) =>
        $"/images/{Uri.EscapeDataString(blobName)}";
}
