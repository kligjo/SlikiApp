@page "/"
@rendermode InteractiveServer

@using Sliki.Web.Components.Shared

<PageTitle>Sliki</PageTitle>

<section class="hero-panel">
    <div>
        <p class="eyebrow">Добредојдовте!</p>
        <h1>Ви благодариме што сте дел од нашиот најубав ден.</h1>
        <p class="hero-copy">
            Прикачете ги вашите фотографии и видеа за заедно да ги зачуваме сите прекрасни спомени. ❤️
        </p>
    </div>
</section>
<section class="home-section">
    <h1 class="section-title">After party here🥂</h1>
    <div class="map-wrapper">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3019.036188543666!2d20.81677872313969!3d41.1045441761556!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1350dbb5377ef5c3%3A0xf12be018ed556603!2sRebel%20Ohrid!5e1!3m2!1sen!2smk!4v1784225675963!5m2!1sen!2smk" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
</section>
<section class="home-section" id="upload">
    <h2 class="section-title">Прикачи фотографии и видеа</h2>
    <ImageUploader />
</section>

@* Gallery hidden for demo - re-enable by uncommenting
<section class="home-section" id="gallery">
    <h2 class="section-title">Галерија</h2>
    <ImageGallery />
</section>
*@
