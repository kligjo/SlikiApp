@inject NavigationManager NavigationManager
@inject IOptions<AccessTokenOptions> AccessTokenOptions

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@HomeUrl">Sliki</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@HomeUrl" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@UploadUrl">
                <span class="bi bi-upload-nav-menu" aria-hidden="true"></span> Upload
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@GalleryUrl">
                <span class="bi bi-image-nav-menu" aria-hidden="true"></span> Gallery
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private string? CurrentAccessToken =>
        AccessTokenUrlHelper.GetTokenFromAbsoluteUri(NavigationManager.Uri, AccessTokenOptions.Value.QueryParameterName);

    private string HomeUrl => AccessTokenUrlHelper.AppendToken("/", AccessTokenOptions.Value.QueryParameterName, CurrentAccessToken);

    private string UploadUrl => AccessTokenUrlHelper.AppendToken("/upload", AccessTokenOptions.Value.QueryParameterName, CurrentAccessToken);

    private string GalleryUrl => AccessTokenUrlHelper.AppendToken("/gallery", AccessTokenOptions.Value.QueryParameterName, CurrentAccessToken);
}

