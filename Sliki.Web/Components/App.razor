@inject NavigationManager NavigationManager
@inject IOptions<AccessTokenOptions> AccessTokenOptions

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@AppendToken(Assets["lib/bootstrap/dist/css/bootstrap.min.css"])" />
    <link rel="stylesheet" href="@AppendToken(Assets["app.css"])" />
    <link rel="stylesheet" href="@AppendToken(Assets["Sliki.Web.styles.css"])" />
    <ImportMap />
    <link rel="icon" type="image/png" href="@AppendToken("favicon.png")" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@AppendToken(Assets["_framework/blazor.web.js"])"></script>
</body>

</html>

@code {
    private string? CurrentAccessToken =>
        AccessTokenUrlHelper.GetTokenFromAbsoluteUri(NavigationManager.Uri, AccessTokenOptions.Value.QueryParameterName);

    private string AppendToken(string path) =>
        AccessTokenUrlHelper.AppendToken(path, AccessTokenOptions.Value.QueryParameterName, CurrentAccessToken);
}
