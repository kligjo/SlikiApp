{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BlobStorage": {
    "ServiceUri": "https://your-storage-account.blob.core.windows.net/",
    "ContainerName": "sliki",
    "MaxUploadBytes": 1073741824,
    "PageSize": 12,
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "image/bmp",
      "video/mp4",
      "video/quicktime",
      "video/webm",
      "video/x-msvideo"
    ]
  },
  "AllowedHosts": "*"
}
